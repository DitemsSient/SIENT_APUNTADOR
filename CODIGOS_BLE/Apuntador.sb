// Apuntador - Esclavo BLE (migrado de Mira v1, sin kit/LED)
// Protocolo UART: recibe $CON\r, envia $1XXXXXXXX\r o $NoCON\r
// El micro debe buscar mensajes que inicien con $ y terminen con \r

DIM rc
DIM addr$   : addr$ = ""
DIM adRpt$  : adRpt$ = ""
DIM scRpt$  : scRpt$ = ""
DIM hConn    : hConn = -1
DIM hSvc
DIM hCharRx
DIM hCharTx
DIM ntfyEnabled : ntfyEnabled = 0
DIM nAttributeMTU : nAttributeMTU = 23
DIM nAttributeLength
DIM nBleMaxPacketLength
DIM uartBuf$ : uartBuf$ = ""
DIM esperandoCon : esperandoCon = 1
DIM listo : listo = 0
DIM myMac$ : myMac$ = ""

#define ATTRIBUTE_MTU_KEY_ID            211
#define ATTRIBUTE_DATA_LENGTH_KEY_ID    212
#define USE_STRINT_IN_EVENTS_KEY_ID     213
#define ENABLE_HIGH_BANDWIDTH_KEY_ID    214
#define BLE_MAX_PACKET_LENGTH_KEY_ID    216

#define ATTRIBUTE_MTU_MAXIMUM           247
#define ATTRIBUTE_DATA_LENGTH_MAXIMUM   244
#define BLE_MAX_PACKET_LENGTH           251

#define ADVERTISING_TIMEOUT_MS          20000

FUNCTION ConfigurarDLE()
    rc = NvCfgKeyGet(ATTRIBUTE_MTU_KEY_ID, nAttributeMTU)
    rc = NvCfgKeyGet(ATTRIBUTE_DATA_LENGTH_KEY_ID, nAttributeLength)
    rc = NvCfgKeyGet(BLE_MAX_PACKET_LENGTH_KEY_ID, nBleMaxPacketLength)
    IF (nAttributeMTU != ATTRIBUTE_MTU_MAXIMUM) || (nAttributeLength != ATTRIBUTE_DATA_LENGTH_MAXIMUM) || (nBleMaxPacketLength != BLE_MAX_PACKET_LENGTH) THEN
        rc = NvCfgKeySet(ATTRIBUTE_MTU_KEY_ID, ATTRIBUTE_MTU_MAXIMUM)
        rc = NvCfgKeySet(ATTRIBUTE_DATA_LENGTH_KEY_ID, ATTRIBUTE_DATA_LENGTH_MAXIMUM)
        rc = NvCfgKeySet(USE_STRINT_IN_EVENTS_KEY_ID, 1)
        rc = NvCfgKeySet(ENABLE_HIGH_BANDWIDTH_KEY_ID, 1)
        rc = NvCfgKeySet(BLE_MAX_PACKET_LENGTH_KEY_ID, BLE_MAX_PACKET_LENGTH)
        Reset(0)
    ENDIF
ENDFUNC 0

PRINT "\n=== Apuntador arrancando ===\n"

rc = ConfigurarDLE()
BleVSpClose()

// MAC propia (14 hex chars), para responder $MAC\r
myMac$ = SysInfo$(4)
myMac$ = StrHexize$(myMac$)

// Crear servicio GATT
rc = BleServiceNew(1, BleHandleUuid16(0x18EE), hSvc)

DIM rxAttr$ : rxAttr$ = ""
rc = BleCharNew(0x0A, BleHandleUuid16(1), BleAttrMetaData(1,1,244,0,rc), 0, 0)
rc = BleCharCommit(hSvc, rxAttr$, hCharRx)

DIM txAttr$ : txAttr$ = ""
DIM mdCccd
mdCccd = BleAttrMetaData(1,1,2,0,rc)
rc = BleCharNew(0x12, BleHandleUuid16(2), BleAttrMetaData(1,0,244,0,rc), mdCccd, 0)
rc = BleCharCommit(hSvc, txAttr$, hCharTx)

rc = BleServiceCommit(hSvc)
PRINT "\nApuntador iniciado"
PRINT "\nEsperando $CON...\n"

FUNCTION IniciarAdvertising()
    rc = BleAdvRptInit(adRpt$, 2, 0, 20)
    rc = BleAdvRptsCommit(adRpt$, scRpt$)
    rc = BleAdvertStart(0, addr$, 100, ADVERTISING_TIMEOUT_MS, 0)
    IF rc == 0 THEN
        esperandoCon = 0
        PRINT "\nAdvertising (20s)..."
    ELSE
        PRINT "\nERROR BleAdvertStart rc="
        PRINT rc
        PRINT "\n"
    ENDIF
ENDFUNC 1

FUNCTION HndlrBleMsg(BYVAL nMsgId AS INTEGER, BYVAL nCtx AS INTEGER)
    SELECT nMsgId
        CASE 0
            hConn = nCtx
            ntfyEnabled = 0
            listo = 1
            PRINT "\nConectado"
            DIM okMsg$
            okMsg$ = "$ACKCON\r"
            PRINT okMsg$
        CASE 1
            hConn = -1
            ntfyEnabled = 0
            listo = 0
            esperandoCon = 1
            DIM dsMsg$
            dsMsg$ = "$DSCON\r"
            PRINT dsMsg$
            TimerStart(1, 200, 0)
        CASE ELSE
    ENDSELECT
ENDFUNC 1

// Espera 200ms tras el $DSCON antes de mandar el log, para no mezclarse en el UART
FUNCTION HndlrTmr1()
    PRINT "\nEsperando $CON...\n"
ENDFUNC 1

// Nadie se conecto en 20s - ya no reintenta advertising solo.
// Ya no se manda $NoCON por UART: el micro ya maneja este timing por su cuenta
// (si no le llega $ACKOK, asume que no hubo conexion).
FUNCTION HndlrAdvTimeout()
    PRINT "\nTimeout - sin conexion"
    esperandoCon = 1
    PRINT "\nEsperando $CON...\n"
ENDFUNC 1

FUNCTION HndlrAttrMTU(BYVAL hC AS INTEGER, BYVAL nSize AS INTEGER)
ENDFUNC 1

FUNCTION HndlrCharCccd(BYVAL charHandle AS INTEGER, BYVAL nVal AS INTEGER)
    IF charHandle == hCharTx THEN
        IF nVal != 0 THEN
            ntfyEnabled = 1
        ELSE
            ntfyEnabled = 0
        ENDIF
    ENDIF
ENDFUNC 1

// Dato recibido de Sensores por GATT write
FUNCTION HndlrCharValue(BYVAL nConnHandle AS INTEGER, BYVAL charHandle AS INTEGER, BYVAL offset AS INTEGER, BYVAL len AS INTEGER, BYVAL Data$)
    IF charHandle == hCharRx THEN
        DIM uartMsg$
        // Todo lo que llega de Sensores se reenvia tal cual al micro
        uartMsg$ = "$" + Data$ + "\r"
        PRINT uartMsg$
    ENDIF
ENDFUNC 1

// Responde $MAC\r con la MAC propia (14 hex chars)
FUNCTION ResponderMac()
    DIM ackMsg$
    ackMsg$ = "$ACKMAC" + myMac$ + "\r"
    PRINT ackMsg$
ENDFUNC 1

// UART - acumular hasta \r, procesar comando
FUNCTION HndlrUartRx()
    DIM chunk$, nBytes, i, ch, oneChar$
    nBytes = UartRead(chunk$)
    IF nBytes == 0 THEN
        EXITFUNC 1
    ENDIF
    i = 0
    WHILE i < nBytes
        ch = StrGetChr(chunk$, i)
        IF ch == 13 THEN
            DIM macStr$
            macStr$ = "$MAC"
            IF StrCmp(uartBuf$, macStr$) == 0 THEN
                rc = ResponderMac()
            ELSEIF esperandoCon == 1 THEN
                DIM conStr$
                conStr$ = "$CON"
                IF StrCmp(uartBuf$, conStr$) == 0 THEN
                    rc = IniciarAdvertising()
                ENDIF
            ELSEIF listo == 1 && ntfyEnabled == 1 THEN
                // Reenviar comando del micro a Sensores por BLE notify
                IF STRLEN(uartBuf$) > 0 THEN
                    DIM bleMsg$
                    DIM d
                    d = StrGetChr(uartBuf$, 0)
                    IF d == 36 THEN
                        bleMsg$ = MID$(uartBuf$, 1, STRLEN(uartBuf$) - 1)
                    ELSE
                        bleMsg$ = uartBuf$
                    ENDIF
                    rc = BleCharValueNotify(hCharTx, bleMsg$)
                ENDIF
            ENDIF
            uartBuf$ = ""
        ELSEIF ch != 10 THEN
            oneChar$ = "."
            rc = StrSetChr(oneChar$, ch, 0)
            uartBuf$ = uartBuf$ + oneChar$
        ENDIF
        i = i + 1
    ENDWHILE
ENDFUNC 1

ONEVENT EVBLEMSG           CALL HndlrBleMsg
ONEVENT EVBLE_ADV_TIMEOUT  CALL HndlrAdvTimeout
ONEVENT EVATTRIBUTEMTU     CALL HndlrAttrMTU
ONEVENT EVCHARCCCD         CALL HndlrCharCccd
ONEVENT EVCHARVALUE        CALL HndlrCharValue
ONEVENT EVUARTRX           CALL HndlrUartRx
ONEVENT EVTMR1             CALL HndlrTmr1

WAITEVENT
